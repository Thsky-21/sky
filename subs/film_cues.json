[
 {
  "t0": 0.4,
  "t1": 5.09,
  "text": "Okay, okay — new idea. Hear me out. Um…\nno, wait. This one's actually big.",
  "who": "FY"
 },
 {
  "t0": 6.04,
  "t1": 8.38,
  "text": "So… did we make it?",
  "who": "FY"
 },
 {
  "t0": 8.42,
  "t1": 9.61,
  "text": "Read it.",
  "who": "TY"
 },
 {
  "t0": 11.26,
  "t1": 12.13,
  "text": "It's blank.",
  "who": "FY"
 },
 {
  "t0": 12.17,
  "t1": 16.425,
  "text": "We don't write things down. We talk. Voice\nnotes, all day, every idea.",
  "who": "FY"
 },
 {
  "t0": 16.465,
  "t1": 18.41,
  "text": "What happened to that guy?",
  "who": "FY"
 },
 {
  "t0": 18.51,
  "t1": 20.43,
  "text": "I don't know how it ends yet.",
  "who": "TY"
 },
 {
  "t0": 20.47,
  "t1": 22.13,
  "text": "Then don't write it. Say it.",
  "who": "FY"
 },
 {
  "t0": 23.98,
  "t1": 25.61,
  "text": "Okay. Did we build anything?",
  "who": "FY"
 },
 {
  "t0": 25.65,
  "t1": 26.79,
  "text": "Three things.",
  "who": "TY"
 },
 {
  "t0": 26.83,
  "t1": 27.88,
  "text": "Three companies?",
  "who": "FY"
 },
 {
  "t0": 27.92,
  "t1": 29.96,
  "text": "Three products. Calm down.",
  "who": "TY"
 },
 {
  "t0": 30.0,
  "t1": 30.92,
  "text": "First one?",
  "who": "FY"
 },
 {
  "t0": 30.96,
  "t1": 36.39,
  "text": "Friends were throwing around a hackathon\nidea. I shipped it in four, five hours.",
  "who": "TY"
 },
 {
  "t0": 36.43,
  "t1": 37.46,
  "text": "Five hours?!",
  "who": "FY"
 },
 {
  "t0": 37.5,
  "t1": 42.72,
  "text": "Two, three days later I'd bought a domain\n— didn't even know how domains worked.",
  "who": "TY"
 },
 {
  "t0": 42.76,
  "t1": 46.01,
  "text": "Ten emails. One reply.",
  "who": "TY"
 },
 {
  "t0": 46.05,
  "t1": 47.13,
  "text": "One reply!",
  "who": "FY"
 },
 {
  "t0": 47.17,
  "t1": 52.81,
  "text": "Wrong customers. Small sites didn't feel\nthe pain. Big ones already had someone.",
  "who": "TY"
 },
 {
  "t0": 52.85,
  "t1": 53.61,
  "text": "Second?",
  "who": "FY"
 },
 {
  "t0": 53.65,
  "t1": 57.98,
  "text": "Spending limits for AI apps. Nobody cared\nabout the bill yet.",
  "who": "TY"
 },
 {
  "t0": 58.02,
  "t1": 58.7,
  "text": "Third?",
  "who": "FY"
 },
 {
  "t0": 58.74,
  "t1": 64.0,
  "text": "Safety rules for AI agents. Five months.\nBest thing I've ever built.",
  "who": "TY"
 },
 {
  "t0": 64.04,
  "t1": 65.78,
  "text": "You sleep at twelve, right?",
  "who": "TY"
 },
 {
  "t0": 65.82,
  "t1": 66.52,
  "text": "…Yeah?",
  "who": "FY"
 },
 {
  "t0": 66.56,
  "t1": 70.76,
  "text": "I was up till three. Every night. Code,\ncustomers, emails.",
  "who": "TY"
 },
 {
  "t0": 70.8,
  "t1": 72.05,
  "text": "So who's using it?",
  "who": "FY"
 },
 {
  "t0": 72.09,
  "t1": 75.7,
  "text": "Fifty emails. Zero replies.",
  "who": "TY"
 },
 {
  "t0": 76.15,
  "t1": 76.96,
  "text": "Did you try—",
  "who": "FY"
 },
 {
  "t0": 77.0,
  "t1": 82.87,
  "text": "Reddit. One post blew up in a few hours.\nMods took it down. Account too new.",
  "who": "TY"
 },
 {
  "t0": 82.91,
  "t1": 84.4,
  "text": "…Of course they did.",
  "who": "FY"
 },
 {
  "t0": 85.25,
  "t1": 85.99,
  "text": "Money?",
  "who": "FY"
 },
 {
  "t0": 86.03,
  "t1": 87.26,
  "text": "Zero.",
  "who": "TY"
 },
 {
  "t0": 88.51,
  "t1": 92.97,
  "text": "I'd promised myself five thousand dollars\na month. By December.",
  "who": "TY"
 },
 {
  "t0": 93.01,
  "t1": 98.285,
  "text": "Placements are next July. Half of me is\npreparing for that. Half of me is here.",
  "who": "TY"
 },
 {
  "t0": 98.325,
  "t1": 99.46,
  "text": "Never all in.",
  "who": "TY"
 },
 {
  "t0": 99.5,
  "t1": 102.56,
  "text": "So two months ago, I stopped. Everything.",
  "who": "TY"
 },
 {
  "t0": 103.61,
  "t1": 106.83,
  "text": "Was I wrong? To want it that big?",
  "who": "FY"
 },
 {
  "t0": 106.88,
  "t1": 113.82,
  "text": "No. You're the only reason I started. You\njust didn't know how long the middle is.",
  "who": "TY"
 },
 {
  "t0": 113.86,
  "t1": 118.916,
  "text": "I kept asking AI for ideas. But real\nproblems don't come from prompts.",
  "who": "TY"
 },
 {
  "t0": 118.956,
  "t1": 124.24,
  "text": "They come from people. And I've been doing\nit all alone, in one room.",
  "who": "TY"
 },
 {
  "t0": 124.28,
  "t1": 125.36,
  "text": "So what's next?",
  "who": "FY"
 },
 {
  "t0": 125.4,
  "t1": 129.24,
  "text": "Get out of this room. Talk to people.\nMaybe physical AI.",
  "who": "TY"
 },
 {
  "t0": 129.28,
  "t1": 131.5,
  "text": "Honestly, I don't know yet.",
  "who": "TY"
 },
 {
  "t0": 131.55,
  "t1": 132.55,
  "text": "It's okay.",
  "who": "FY"
 },
 {
  "t0": 132.59,
  "t1": 133.4,
  "text": "…What?",
  "who": "TY"
 },
 {
  "t0": 133.44,
  "t1": 134.85,
  "text": "It's okay. You'll do it.",
  "who": "FY"
 },
 {
  "t0": 134.89,
  "t1": 136.22,
  "text": "How do you know?",
  "who": "TY"
 },
 {
  "t0": 136.26,
  "t1": 137.92,
  "text": "You're still talking to me.",
  "who": "FY"
 },
 {
  "t0": 139.97,
  "t1": 142.53,
  "text": "Don't write it. Say it.",
  "who": "FY"
 },
 {
  "t0": 143.58,
  "t1": 145.99,
  "text": "Okay. New idea. Hear me out.",
  "who": "TY"
 }
]