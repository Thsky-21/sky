[
 {
  "t0": 0.4,
  "t1": 5.07,
  "text": "Okay, okay — new idea. Hear me out. Um…\nno, wait. This one's actually big.",
  "who": "FY"
 },
 {
  "t0": 6.02,
  "t1": 8.63,
  "text": "So… did we make it?",
  "who": "FY"
 },
 {
  "t0": 8.67,
  "t1": 9.89,
  "text": "Read it.",
  "who": "TY"
 },
 {
  "t0": 11.54,
  "t1": 12.5,
  "text": "It's blank.",
  "who": "FY"
 },
 {
  "t0": 12.54,
  "t1": 16.08,
  "text": "We don't write things down. We talk. Voice\nnotes, all day, every idea.",
  "who": "FY"
 },
 {
  "t0": 16.12,
  "t1": 17.8,
  "text": "What happened to that guy?",
  "who": "FY"
 },
 {
  "t0": 17.9,
  "t1": 20.27,
  "text": "I don't know how it ends yet.",
  "who": "TY"
 },
 {
  "t0": 20.31,
  "t1": 22.17,
  "text": "Then don't write it. Say it.",
  "who": "FY"
 },
 {
  "t0": 24.02,
  "t1": 25.8,
  "text": "Okay. Did we build anything?",
  "who": "FY"
 },
 {
  "t0": 25.84,
  "t1": 27.23,
  "text": "Three things.",
  "who": "TY"
 },
 {
  "t0": 27.27,
  "t1": 28.57,
  "text": "Three companies?",
  "who": "FY"
 },
 {
  "t0": 28.61,
  "t1": 31.11,
  "text": "Three products. Calm down.",
  "who": "TY"
 },
 {
  "t0": 31.15,
  "t1": 32.77,
  "text": "…Okay. First one.",
  "who": "FY"
 },
 {
  "t0": 32.81,
  "t1": 38.41,
  "text": "Friends were throwing around a hackathon\nidea. I shipped it in four, five hours.",
  "who": "TY"
 },
 {
  "t0": 38.45,
  "t1": 44.3,
  "text": "Two, three days later I'd bought a domain\n— didn't even know how domains worked.",
  "who": "TY"
 },
 {
  "t0": 44.34,
  "t1": 48.23,
  "text": "Ten emails. One reply.",
  "who": "TY"
 },
 {
  "t0": 48.27,
  "t1": 49.56,
  "text": "One reply!",
  "who": "FY"
 },
 {
  "t0": 49.6,
  "t1": 55.4,
  "text": "Wrong customers. Small sites didn't feel\nthe pain. Big ones already had someone.",
  "who": "TY"
 },
 {
  "t0": 55.44,
  "t1": 56.28,
  "text": "Second?",
  "who": "FY"
 },
 {
  "t0": 56.32,
  "t1": 61.27,
  "text": "Spending limits for AI apps. Nobody cared\nabout the bill yet.",
  "who": "TY"
 },
 {
  "t0": 61.31,
  "t1": 62.1,
  "text": "Third?",
  "who": "FY"
 },
 {
  "t0": 62.14,
  "t1": 67.77,
  "text": "Safety rules for AI agents. Five months.\nBest thing I've ever built.",
  "who": "TY"
 },
 {
  "t0": 67.81,
  "t1": 71.825,
  "text": "You sleep at twelve, right? I was up till\nthree. Every night.",
  "who": "TY"
 },
 {
  "t0": 71.865,
  "t1": 73.62,
  "text": "Code, customers, emails.",
  "who": "TY"
 },
 {
  "t0": 73.66,
  "t1": 75.21,
  "text": "So who's using it?",
  "who": "FY"
 },
 {
  "t0": 75.25,
  "t1": 80.01,
  "text": "Fifty emails. Zero replies.",
  "who": "TY"
 },
 {
  "t0": 81.46,
  "t1": 82.45,
  "text": "Did you try—",
  "who": "FY"
 },
 {
  "t0": 82.49,
  "t1": 88.222,
  "text": "Articles. Reddit. One post blew up in a\nfew hours. Mods took it down.",
  "who": "TY"
 },
 {
  "t0": 88.262,
  "t1": 89.86,
  "text": "Account too new.",
  "who": "TY"
 },
 {
  "t0": 89.9,
  "t1": 91.59,
  "text": "…Of course they did.",
  "who": "FY"
 },
 {
  "t0": 92.44,
  "t1": 93.31,
  "text": "Money?",
  "who": "FY"
 },
 {
  "t0": 93.35,
  "t1": 94.58,
  "text": "Zero.",
  "who": "TY"
 },
 {
  "t0": 95.83,
  "t1": 100.97,
  "text": "I'd promised myself five thousand dollars\na month. By December.",
  "who": "TY"
 },
 {
  "t0": 101.01,
  "t1": 106.285,
  "text": "Placements are next July. Half of me is\npreparing for that. Half of me is here.",
  "who": "TY"
 },
 {
  "t0": 106.325,
  "t1": 107.46,
  "text": "Never all in.",
  "who": "TY"
 },
 {
  "t0": 107.5,
  "t1": 110.9,
  "text": "So two months ago, I stopped. Everything.",
  "who": "TY"
 },
 {
  "t0": 111.95,
  "t1": 115.7,
  "text": "Was I wrong? To want it that big?",
  "who": "FY"
 },
 {
  "t0": 115.75,
  "t1": 123.09,
  "text": "No. You're the only reason I started. You\njust didn't know how long the middle is.",
  "who": "TY"
 },
 {
  "t0": 123.13,
  "t1": 128.191,
  "text": "I kept asking AI for ideas. But real\nproblems don't come from prompts.",
  "who": "TY"
 },
 {
  "t0": 128.231,
  "t1": 133.52,
  "text": "They come from people. And I've been doing\nit all alone, in one room.",
  "who": "TY"
 },
 {
  "t0": 133.56,
  "t1": 134.89,
  "text": "So what's next?",
  "who": "FY"
 },
 {
  "t0": 134.93,
  "t1": 138.884,
  "text": "Get out of this room. Talk to people.\nMaybe physical AI.",
  "who": "TY"
 },
 {
  "t0": 138.924,
  "t1": 141.2,
  "text": "Honestly, I don't know yet.",
  "who": "TY"
 },
 {
  "t0": 141.25,
  "t1": 142.4,
  "text": "It's okay.",
  "who": "FY"
 },
 {
  "t0": 142.44,
  "t1": 143.35,
  "text": "…What?",
  "who": "TY"
 },
 {
  "t0": 143.39,
  "t1": 145.15,
  "text": "It's okay. You'll do it.",
  "who": "FY"
 },
 {
  "t0": 145.19,
  "t1": 146.55,
  "text": "How do you know?",
  "who": "TY"
 },
 {
  "t0": 146.59,
  "t1": 148.52,
  "text": "You're still talking to me.",
  "who": "FY"
 },
 {
  "t0": 150.57,
  "t1": 153.4,
  "text": "Don't write it. Say it.",
  "who": "FY"
 },
 {
  "t0": 154.45,
  "t1": 157.01,
  "text": "Okay. New idea. Hear me out.",
  "who": "TY"
 }
]